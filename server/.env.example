# PRIVYSE server environment. Copy to `.env` and edit.
# docker compose reads this automatically.

# ── VLM backend (OpenAI-compatible) ─────────────────────────────────────────
# Hosted endpoint (OpenAI, vLLM, TGI, OpenRouter, …):
# OPENAI_BASE_URL=https://api.openai.com/v1
# VLM_API_KEY=sk-...
# VLM_MODEL=gpt-4o-mini
#
# Bundled Ollama (docker compose --profile gpu up):
OPENAI_BASE_URL=http://ollama:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen2.5vl:3b

# ── Generation / context tuning ─────────────────────────────────────────────
VLM_MAX_TOKENS=128
NUM_CTX=4096
IMAGE_MAX_SIDE=800

# ── Host port for the FastAPI server ────────────────────────────────────────
SERVER_PORT=8000
